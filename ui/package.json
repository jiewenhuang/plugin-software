{
  "type": "module",
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "dev": "vite build --watch --mode=development",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path ../.gitignore",
    "lint:eslint": "eslint . --fix",
    "lint:oxlint:check": "oxlint . -D correctness --ignore-path ../.gitignore",
    "lint:eslint:check": "eslint .",
    "lint:check": "run-s lint:*:check",
    "lint": "run-s lint:oxlint lint:eslint",
    "prettier": "prettier --write src/",
    "test:unit": "vitest --passWithNoTests",
    "type-check": "vue-tsc --build"
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2
  },
  "dependencies": {
    "@halo-dev/api-client": "^2.26.0",
    "@halo-dev/components": "^2.26.0",
    "@halo-dev/richtext-editor": "^2.26.0",
    "@halo-dev/ui-shared": "^2.26.0",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "vite": "^8.3.4",
    "@halo-dev/ui-plugin-bundler-kit": "^2.26.0",
    "@iconify-json/ri": "^1.2.6",
    "@tsconfig/node20": "^20.1.10",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.41",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.4",
    "eslint-plugin-oxlint": "^0.16.12",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^0.16.12",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "typescript": "~5.8.3",
    "unplugin-icons": "^23.0.1",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "form-data": "4.0.6",
      "immutable": "5.1.9",
      "postcss": "8.5.23"
    }
  }
}
